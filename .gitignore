# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/
# default CLI output from `go build ./...` on *nix (matches module name)
/lsimons-template-go
# After `mise run init` replaces the placeholder, keep the module-named
# binary out of git by renaming this line to /<your-project>.

# Test binaries and output
*.test
*.out
coverage.out
coverage.html
coverage.txt

# Go workspace (single-module repo by default)
go.work
go.work.sum

# Vendored dependencies (opt-in only)
vendor/

# go.sum is the lock file: it is committed and must never be ignored.
# It is listed here as a reminder, not as a pattern.

# Go build/test cache
.cache/

# Profiles and traces
*.prof
*.trace

# Environment
.env
.env.*

# mise local overrides (the committed .mise.toml is the shared config)
.mise.local.toml
mise.local.toml
.mise/

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~

# Operating systems
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Claude
# `.claude/` itself is tracked on purpose — settings.json is shared
# config. Only per-user state and scratch worktrees are ignored.
.claude/settings.local.json
.claude/worktrees
