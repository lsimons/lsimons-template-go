# https://editorconfig.org/
# Keeps editors that are not running gofumpt in line with what is
# actually committed in this tree.
root = true

# The 4-space default is for `scripts/init.py`; Go, TOML, YAML, JSON and
# Markdown all override it below.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# gofmt/gofumpt indent with tabs and will rewrite anything else.
[*.go]
indent_style = tab

# The Go toolchain writes go.mod/go.sum with tabs.
[{go.mod,go.sum}]
indent_style = tab

# TOML is listed here on purpose: `mise fmt` owns `.mise.toml` and emits
# 2-space indents, so the [*] default of 4 would have editors and
# `mise fmt` reindenting the file back and forth. Verified against the
# committed file, not assumed.
[*.{yml,yaml,json,toml,md}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
